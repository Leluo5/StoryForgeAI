# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# 覆盖率产物（pytest 运行时生成，不进库）
.coverage
.coverage.*
coverage.json
htmlcov/
.coverage_cache/

# 运行时数据（项目/知识库/锁/测试工作区，均不进库）
data/

# 上传临时目录
.uploads/

# 本地日志与运行产物
*.log
*.pid
logs/

# 编辑器/系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 浏览器自动化运行时 profile（截图证据只保留 png，浏览器缓存/配置不进库）
**/screenshots/*-profile/

# CDP 诊断临时脚本（含 node_modules，仅诊断用，不进库）
scripts/cdp_tmp/

# git 提交日志（pre-commit 钩子运行产物，不进库）
.git_commit_log.txt

# 历史归档目录（不进主仓库）
docs-archive/

# Node 工作区
node_modules/
dist/
coverage/
.playwright/
playwright-report/
test-results/
.env
.env.*
!.env.example
