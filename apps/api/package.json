{
  "name": "@storyforge/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "start:prod": "node dist/main.js",
    "migration:run": "tsx src/database/run-migrations.ts",
    "bootstrap:author": "tsx src/auth/bootstrap-author.ts",
    "test:prepare": "tsx test/prepare-e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/typeorm": "^11.0.3",
    "@storyforge/contracts": "workspace:*",
    "@storyforge/editor-schema": "workspace:*",
    "argon2": "^0.45.2",
    "bullmq": "^5.36.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "iconv-lite": "^0.7.3",
    "ioredis": "^5.6.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "unpdf": "1.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/iconv-lite": "^0.0.1",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "prosemirror-model": "^1.25.1",
    "prosemirror-transform": "^1.10.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
